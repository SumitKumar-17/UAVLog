# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=uavlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uavlog
POSTGRES_PORT=5433

# OpenAI-compatible API (key and base URL from the environment; shared client in backend/app/llm.py)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# Data locations inside containers (override on the full-scale SSH machine)
DATA_DIR=/data
HOST_UID=1000
HOST_GID=1000
API_PORT=8000
WEB_PORT=3000

# Optional hardening: set a password to create the restricted login role uav_nlsql (migration 0007) and use it for model-written SQL.
# NLSQL_DB_PASSWORD=
# Set ALLOW_WRITES=0 for a read-only deployment (disables investigation notes).
# ALLOW_WRITES=1
