# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=uavlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uavlog
POSTGRES_PORT=5433

# OpenAI-compatible API (key and base URL from the environment; shared client in backend/app/llm.py)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# Data locations inside containers (override on the full-scale SSH machine)
DATA_DIR=/data
HOST_UID=1000
HOST_GID=1000
API_PORT=8000
