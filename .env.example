# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=uavlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uavlog
POSTGRES_PORT=5433

# LLM access goes through LiteLLM
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMS=1536

# Data locations inside containers (override on the full-scale SSH machine)
DATA_DIR=/data
HOST_UID=1000
HOST_GID=1000
