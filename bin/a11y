#!/usr/bin/env bash
# ./bin/a11y [paths...]  -> axe-core audit (WCAG 2.1 AA) of the running web app, in Docker. Default: the main pages.
set -euo pipefail
cd "$(dirname "$0")/.."
paths=("$@"); [ ${#paths[@]} -gt 0 ] || paths=(/ /flights /map /fleet /incidents /patterns /signals /rules /ask /workbench /data /performance /benchmarks /upload)
docker run --rm --network host -u "$(id -u):$(id -g)" -e HOME=/tmp -e NODE_PATH=/tmp/pw/node_modules -v "$PWD":/work -w /work mcr.microsoft.com/playwright:v1.55.0-noble \
  sh -c "[ -d /tmp/pw/node_modules/axe-core ] || npm i playwright@1.55.0 axe-core --no-save --silent --prefix /tmp/pw >/dev/null 2>&1; node tools/a11y.cjs 'http://localhost:${WEB_PORT:-3000}' ${paths[*]}"
