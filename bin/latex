#!/usr/bin/env bash
# ./bin/latex slides/UAVLog_Project_PPT.tex   (or report/UAVLog_Report.tex)  -> the PDF next to the .tex file
# Compiles twice with pdflatex in Docker (image uavlog-latex, built from tools/latex/Dockerfile on first use). Paths inside the documents are relative to the repository root.
set -euo pipefail
cd "$(dirname "$0")/.."
f="${1:?path/to/file.tex}"; dir=$(dirname "$f"); name=$(basename "${f%.tex}")
docker image inspect uavlog-latex >/dev/null 2>&1 || docker build -t uavlog-latex tools/latex
for _ in 1 2; do
  docker run --rm -u "$(id -u):$(id -g)" -v "$PWD":/work -w /work uavlog-latex pdflatex -interaction=nonstopmode -halt-on-error -output-directory "$dir" "$f" >"$dir/$name.log" 2>&1 || { grep -A6 '^!' "$dir/$name.log" | head -30; exit 1; }
done
echo "$dir/$name.pdf"
